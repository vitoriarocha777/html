programa {
  funcao inicio() {
    //declaracão de variaveis 
    real numero1, numero2, media
    cadeia nomeAluno

    //entrada de dados
    escreva("programar para calcular a media\n")
    escreva("informe seu nome: ")
    leia(nomeAluno)
    escreva("informe o primeiro numero: ")
    leia(numero1)
    escreva("informe o segundo numero: ")
    leia(numero2)

    //calculo da media
  media = (numero1 + numero2 ) /2
  
  escreva("olá," + nomeAluno + "sua media é:" + media)
  


  }
}
