programa {
  funcao inicio() {
    //Declaração de variáveis
    cadeia nomeFuncionario
    real salarioFixo, valordeVendas, bonus, salarioTotal
    cadeia nomeFuncionario 

    escreva("informe nomeFuncionario")
    leia(nomeFuncionario)

    escreva("informe salario fixo: ")
    leia(salarioFixo)

    escreva("informe valor de vendas: ")
    leia(valordeVendas)

    escreva("informe o bonus")
    leia(bonus)

    escreva("informe salario total")
    leia(salarioTotal)

    //calculo da média
    media = ("salarioFixo + valordeVendas + bonus + salarioTotal")
    
  }
}
